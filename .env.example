# Copy this file to .env. Never put a real key in this example file.
# OpenAI API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=replace_with_your_openai_api_key

# DeepSeek API key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=replace_with_your_ds_api_key

# The web console selects the provider and model itself. This is optional and
# only supplies a default for OpenAI CLI usage when --model is omitted.
# OPENAI_MODEL=gpt-5.6-terra
